generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gasto {
  id            Int        @id @default(autoincrement())
  usuarioId     String
  gasto         Float
  montoAnterior Float
  fecha         DateTime
  categoriaId   Int
  categoria     Categorias @relation(fields: [categoriaId], references: [id])
}

model Ingreso {
  id            Int      @id @default(autoincrement())
  usuarioId     String
  ingreso       Decimal
  montoAnterior Float
  fecha         DateTime
}

model Categorias {
  id          Int                    @id @default(autoincrement())
  usuarioId   String
  nombre      String
  icono       String?
  color       String?
  descripcion String?
  editable    Boolean                @default(true)
  gastos      Gasto[]
  presupuesto PresupuestoCategoria[]
}

model Presupuesto {
  id                   Int                    @id @default(autoincrement())
  usuarioId            String
  monto                Int
  fechaInicio          DateTime
  fechaFin             DateTime
  PresupuestoCategoria PresupuestoCategoria[]
}

model PresupuestoCategoria {
  id            Int         @id @default(autoincrement())
  presupuestoId Int
  categoriaId   Int
  monto         Int
  gastadoAct    Int         @default(0)
  alerta        Boolean     @default(false)
  limiteAlerta  Int         @default(100)
  alertaVista   Boolean     @default(false)
  presupuesto   Presupuesto @relation(fields: [presupuestoId], references: [id])
  categoria     Categorias  @relation(fields: [categoriaId], references: [id])
}

model Usuario {
  id          String  @id
  nombre      String
  email       String  @unique
  isDeveloper Boolean @default(false)
  APISecret   String?
}

model Racha {
  usuarioId   String   @id @unique
  rachaActual Int
  ultimaFecha DateTime
  isInactive  Boolean  @default(true)
}

model Piggy {
  id        String            @id @default(uuid())
  usuarioId String            @unique
  nombre    String            @default("Piggy")
  xp        Int               @default(0)
  avatarId  Int               @default(0)
  objetivos ObjetivoUsuario[]
}

model Objetivo {
  id               Int               @id @default(autoincrement())
  descripcion      String
  accion           String
  maxProgreso      Int
  objetivoUsuarios ObjetivoUsuario[]
}

model ObjetivoUsuario {
  id         Int      @id @default(autoincrement())
  objetivoId Int
  objetivo   Objetivo @relation(fields: [objetivoId], references: [id])
  progreso   Int      @default(0)
  piggy      Piggy?   @relation(fields: [piggyId], references: [id])
  piggyId    String?
}

model OAuthCode {
  id        String   @id @default(cuid())
  codeHash  String
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
}
